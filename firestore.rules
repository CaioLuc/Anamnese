rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function for the hierarchical structure: psicologos/{uid}/...
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Helper function to check if the user is an admin
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ===================================
    // ADMIN ACCESS
    // ===================================
    match /admins/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ===================================
    // ESTRUTURA PROTEGIDA (PER-USER)
    // ===================================
    // ===================================
    // SLUG LOOKUP (Leitura pública)
    // ===================================
    match /slugs/{slug} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /psicologos/{uid} {
      // O próprio psicólogo pode ler e editar seu perfil
      // Admins podem ler e editar qualquer perfil
      allow read, write: if isOwner(uid) || isAdmin();
      
      // Regras para subcoleções dentro do perfil do psicólogo
      match /pacientes/{pid} {
        allow read, write: if isOwner(uid) || isAdmin();
        
        match /anamneses/{aid} {
          allow read, write: if isOwner(uid);
        }
        
        match /sessoes/{sid} {
          allow read, write: if isOwner(uid);
        }
      }
      
      match /questionarios/{qid} {
        allow read, write: if isOwner(uid);
      }
      
      // Agendamentos: PRIVADO — contém dados pessoais (nome, CPF, telefone)
      // Somente o psicólogo dono pode ler e gerenciar
      // Criação pública permitida (paciente agenda pelo link)
      match /agendamentos/{aid} {
        allow read, update, delete: if isOwner(uid);
        allow create: if true;
      }

      // Horários ocupados: PÚBLICO — espelho seguro (apenas data, hora, duração, status)
      // Nenhum dado pessoal. Leitura e criação públicas para a página de agendamento.
      match /horarios_ocupados/{sid} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isOwner(uid);
      }

      match /clinicas/{cid} {
        allow read, write: if isOwner(uid);
      }

      // Config da agenda: dono escreve, leitura pública (para página de agendamento)
      match /config/{docId} {
        allow read: if true;
        allow write: if isOwner(uid);
      }
    }

    // ===================================
    // CONFIG GLOBAL (avisos, etc.)
    // ===================================
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Bloqueio padrão para qualquer outra rota não especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
